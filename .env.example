# Copy to .env and fill in ONE provider key. .env is git-ignored; never commit keys.
# With no key, SciForge still runs on its built-in topic templates.

ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# auto (default: first provider above with a key) | anthropic | xai | openai | ollama | none
SCIFORGE_LLM_PROVIDER=auto
# Leave empty for the provider default: claude-opus-5, grok-4, gpt-5, llama3.1 (Ollama)
SCIFORGE_LLM_MODEL=
# Claude only: low | medium | high | xhigh | max
SCIFORGE_LLM_EFFORT=high
# Paper characters sent to the model (lower it for small local Ollama models)
SCIFORGE_LLM_MAX_CHARS=400000
SCIFORGE_LLM_TIMEOUT=600

# Tesseract language code for OCR on image-only PDF pages
SCIFORGE_OCR_LANGUAGE=eng

# Ollama (local, free): install from ollama.com, `ollama pull llama3.1`, set SCIFORGE_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
